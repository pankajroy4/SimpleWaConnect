<%if false %>
<!-- app/views/customers/show.html.erb -->
<turbo-frame id="chat_frame">
  <script>window.CURRENT_USER_ID = <%= current_user.id %>;</script>
  <script>window.OPEN_CUSTOMER_ID = <%= @customer.id %>;</script>
  <div class="flex flex-col h-full w-full">
    <section class="flex flex-col flex-1 h-full">
      <header class="p-4 border-b border-[#122022] flex items-center justify-between bg-[#061010]">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-[#2b3b3a] flex items-center justify-center text-white font-semibold">
            <%= (@customer&.name.presence || @customer&.display_name || "U")[0].upcase %>
          </div>
          <div class="flex flex-col leading-tight">
            <div class="font-semibold text-lg">
              <%= @customer&.display_name || "Unknown User" %>
            </div>
            <div class="text-xs text-gray-400">
              Last active:
              <span id="<%= dom_id(@customer, :last_active) %>"> 
               <%= render partial: "customers/last_active", locals: { customer: @customer } %>
              </span>
              ago
            </div>
          </div>
        </div>
        <details class="relative">
          <summary class="list-none w-7 h-7 flex items-center justify-center rounded-full bg-[#112020] text-gray-300 hover:bg-[#142626] cursor-pointer">
            <i class='bx bx-info-circle text-xl'></i>
          </summary>
          <div class="absolute right-0 mt-2 w-32 bg-[#0d1a1a] text-white rounded-md shadow border border-gray-700 z-50">
            <%= button_to "Logout", destroy_user_session_path, method: :delete, data: { turbo_method: :delete, turbo_frame: "_top" }, class: "w-full text-left px-4 py-2 text-sm hover:bg-[#142626] hover:cursor-pointer" %>
          </div>
        </details>
      </header>

      <main data-controller="auto-scroll scrollbar infinite-scroll" data-auto-scroll-customer-id-value="<%= @customer.id %>"  data-infinite-scroll-customer-id-value="<%= @customer.id %>" data-infinite-scroll-next-page-value="<%= @pagy&.next %>" class="flex-1 overflow-y-auto p-6" id="messages-list-<%= @customer.id %>">

        <div id="infinite-loading-<%= @customer.id %>" class="text-center text-gray-400 my-4 hidden flex items-center justify-center">
          <i class='bx bx-loader-alt bx-spin text-2xl'></i>
        </div>

        <div id="messages-container-<%= @customer.id %>" data-infinite-scroll-target="container">
          <%= render partial: "messages/messages", locals: { messages: @messages } %>
        </div>

      </main>
      <turbo-frame id="new_message">
        <%= render partial: "messages/form", locals: { customer: @customer } %>
      </turbo-frame>
    </section>
  </div>
</turbo-frame>
<%end%>

<!-- ============================================================================================= -->

<%if true %>
<!-- app/views/customers/show.html.erb -->
<turbo-frame id="chat_frame">
  <script>window.CURRENT_USER_ID = <%= current_user.id %>;</script>
  <script>window.OPEN_CUSTOMER_ID = <%= @customer.id %>;</script>
  <div class="flex flex-col h-full w-full">
    <section class="flex flex-col flex-1 h-full">
      <!-- HEADER -->
      <header class="h-16 px-4 border-b border-[rgb(var(--border))] flex items-center justify-between bg-[rgb(var(--header))]">
        <!-- LEFT GROUP: hamburger + avatar + name -->
        <div class="flex items-center space-x-3 min-w-0">
          <!-- Mobile sidebar open -->
          <button type="button" data-action="click->mobile-sidebar#open" class="md:hidden w-9 h-9 flex items-center justify-center rounded-full flex-shrink-0 hover:bg-[rgb(var(--hover))] hover:ring-1 hover:ring-[rgb(var(--border))] text-[rgb(var(--muted))] hover:text-[rgb(var(--text))] transition" title="Open chats">
            <i class="bx bx-menu text-2xl"></i>
          </button>
          <!-- Avatar -->
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-semibold uppercase flex-shrink-0 bg-gradient-to-br from-slate-100 via-white to-slate-300 text-slate-800 ring-1 ring-slate-300 shadow-[0_1px_2px_rgba(0,0,0,0.10)] dark:from-slate-600 dark:via-slate-700 dark:to-slate-900 dark:text-slate-100 dark:ring-white/10 dark:shadow-none">
            <span class="drop-shadow-[0_1px_0_rgba(255,255,255,0.8)] dark:drop-shadow-none">
              <%= current_user.name.to_s[0]&.upcase || "C" %>
            </span>
          </div>
          <!-- Name + last active -->
          <div class="flex flex-col leading-tight min-w-0">
            <div class="font-semibold text-[15px] text-[rgb(var(--text))] truncate">
              <%= @customer&.display_name || "Unknown User" %>
            </div>
            <div class="text-[11px] text-[rgb(var(--muted))] truncate">
              Last active:
              <span id="<%= dom_id(@customer, :last_active) %>">
                <%= render partial: "customers/last_active", locals: { customer: @customer } %>
              </span>
              ago
            </div>
          </div>
        </div>

        <!-- RIGHT GROUP: info/logout -->
        <details data-controller="dropdown" class="relative flex-shrink-0">
          <summary
            class="list-none w-9 h-9 flex items-center justify-center rounded-full hover:bg-[rgb(var(--hover))] hover:ring-1 hover:ring-[rgb(var(--border))] text-[rgb(var(--muted))] hover:text-[rgb(var(--text))] cursor-pointer transition"
            title="Info">
            <i class='bx bx-info-circle text-xl'></i>
          </summary>

          <div class="absolute right-0 mt-2 w-32 bg-[rgb(var(--panel))] text-[rgb(var(--text))] rounded-md shadow border border-[rgb(var(--border))] z-50">
            <%= button_to destroy_user_session_path, method: :delete, data: { turbo_method: :delete, turbo_frame: "_top" }, class: "w-full flex items-center space-x-2 px-4 py-2 text-sm hover:bg-[rgb(var(--hover))] hover:cursor-pointer" do %>
              <i class='bx bx-log-out text-lg'></i>
              <span>Logout</span>
            <% end %>
          </div>
        </details>
      </header>

      <!-- CHAT BODY -->
      <main data-controller="auto-scroll scrollbar infinite-scroll" data-auto-scroll-customer-id-value="<%= @customer.id %>" data-infinite-scroll-customer-id-value="<%= @customer.id %>" data-infinite-scroll-next-page-value="<%= @pagy&.next %>" class="flex-1 overflow-y-auto p-6 bg-[rgb(var(--chat-bg))] chat-wallpaper" id="messages-list-<%= @customer.id %>">
        <div id="infinite-loading-<%= @customer.id %>" class="text-center text-[rgb(var(--muted))] my-4 hidden flex items-center justify-center">
          <i class='bx bx-loader-alt bx-spin text-2xl'></i>
        </div>
        <div id="messages-container-<%= @customer.id %>" data-infinite-scroll-target="container">
          <% if @messages.blank? %>
            <%= render partial: "messages/empty_conversation" %>
          <% else %>
            <%= render partial: "messages/messages", locals: { messages: @messages } %>
          <% end %>
        </div>
      </main>

      <!-- MESSAGE FORM -->
      <turbo-frame id="new_message">
        <%= render partial: "messages/form", locals: { customer: @customer } %>
      </turbo-frame>
    </section>
  </div>
</turbo-frame>
<%end%>