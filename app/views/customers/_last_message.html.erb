<div id="<%= dom_id(customer, :last_message) %>" class="w-full block text-xs text-gray-400 flex items-center justify-between gap-2 min-w-0">
  <span class="truncate overflow-hidden whitespace-nowrap min-w-0 flex-1 text-[12px]">
    <%= customer.messages.last&.payload&.dig("body_text") %>
  </span>
  <span class="text-[10px] whitespace-nowrap flex-shrink-0 ml-2">
    <%= customer.messages.last&.created_at&.strftime("%I:%M %p") %>
  </span>
</div>
