<span class="absolute right-5 top-1/2 -translate-y-1/2 cursor-pointer select-none text-white/90 hover:text-white" data-action="click->toggle-password#toggle">
  <span data-toggle-password-target="eye" class="block">
    <%= svg_icon "eye", class: "w-5 h-5" %>
  </span>
  <span data-toggle-password-target="eyeSlash" class="hidden">
    <%= svg_icon "eye-off", class: "w-5 h-5" %>
  </span>
</span>