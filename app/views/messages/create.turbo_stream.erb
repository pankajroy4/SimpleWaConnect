<!-- app/views/messages/create.turbo_stream.erb -->
<%= turbo_stream.append "messages-container-#{new_message.customer.id}" do %>
  <%= render partial: "messages/message", locals: { message: new_message } %>
<% end %>

<%= turbo_stream.replace "customer-list-item-#{new_message.customer.id}" do %>
  <%= render partial: "customers/list_item", locals: { customer: new_message.customer } %>
<% end %>
