<%if false %>
<% outgoing = message.outgoing? %>
<div id="<%= dom_id(message, :message) %>" data-message-id="msg-<%= message.id %>" class="w-full mb-2 flex <%= outgoing ? 'justify-end' : 'justify-start' %> ">
  <div class="relative inline-flex flex-col max-w-[85%] sm:max-w-[70%] min-w-[96px] px-2 py-1 shadow-sm <%= outgoing ? 'bg-[#005C4B] text-white rounded-l-lg rounded-br-lg' : 'bg-[#202C33] text-white rounded-r-lg rounded-bl-lg' %>">
    <% if outgoing %>
      <div class="absolute top-0 -right-2 w-3 h-[13px] text-[#005C4B]">
        <svg viewBox="0 0 8 13" preserveAspectRatio="none" class="w-full h-full fill-current">
          <path d="M0 0v13l8-13H0z"></path>
        </svg>
      </div>
    <% else %>
      <div class="absolute top-0 -left-2 w-3 h-[13px] text-[#202C33]">
        <svg viewBox="0 0 8 13" preserveAspectRatio="none" class="w-full h-full fill-current">
          <path d="M8 0v13L0 0h8z"></path>
        </svg>
      </div>
    <% end %>

    <!-- Media -->
    <% media_type = message.payload["media_type"] %>

    <% if media_type.present? %>
      <div class="mb-0.5">
        <% if media_type == "location" %>
            <% lat = message.payload["latitude"] %>
            <% lng = message.payload["longitude"] %>
            <% maps_url = "https://www.google.com/maps?q=#{lat},#{lng}" %>
            <a href="<%= maps_url %>" target="_blank" rel="noopener" class="block w-[280px] max-w-full overflow-hidden rounded-lg border border-black/10 bg-white">
              <div class="h-[140px] w-full overflow-hidden rounded-t-lg bg-gray-200 ">
                <%= image_tag "fake_map_preview.jpg", class: "w-full h-full object-cover opacity-90" %>
                <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-full">
                  <i class="bx bxs-map text-red-500 text-[22px] drop-shadow-md"></i>
                </div>
              </div>
              <div class="px-2 py-1.5 bg-gray-200 rounded border border-black/10">
                <div class="text-[13px] font-medium text-[#303030]">Location</div>
                <div class="text-[11px] text-[#667781]"><%= lat %>, <%= lng %></div>
              </div>
            </a>
        <% else %>
          <% media_src = if message.payload["media_id"].present?
              medium_path(message.id)
            elsif message.payload["media_url"].present?
              message.payload["media_url"]
            end
          %>

          <% if media_src.present? %> 
            <% case media_type %>
            <% when "image" %>
              <div class="relative max-w-[280px] rounded-lg overflow-hidden bg-black/5 group">
                <%= image_tag media_src, class: "w-full max-h-[320px] object-contain block"%>
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                <a href="<%= media_src %>" download class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-10 pointer-events-none">
                  <div class="pointer-events-auto bg-black/70 hover:bg-black/80 text-white rounded-full p-3 flex items-center justify-center">
                    <i class="bx bx-download text-2xl"></i>
                  </div>
                </a>
              </div>

            <% when "video" %>
              <div class="relative max-w-[280px] rounded-lg overflow-hidden bg-black group">
                <video controls class="w-full max-h-[320px] object-contain block bg-black"> <source src="<%= media_src %>" type="video/mp4"></video>
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                </div>
                <a href="<%= media_src %>" download class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-10 pointer-events-none">
                  <div class="pointer-events-auto bg-black/70 hover:bg-black/80 text-white rounded-full p-3 flex items-center justify-center cursor-pointer">
                    <i class="bx bx-download text-2xl"></i>
                  </div>
                </a>
              </div>

            <% when "audio" %>
              <div class="mb-1 bg-black/20 rounded-xl px-3 py-2 flex items-center gap-3">
                <audio controls class="h-8 flex-1 focus:outline-none">
                  <source src="<%= media_src %>" type="audio/mpeg">
                  Your browser does not support audio playback.
                </audio>
                <a href="<%= media_src %>" download class="text-white/70 hover:text-white text-xl">
                  <i class='bx bx-download'></i>
                </a>
              </div>

            <% when "document" %>
              <div class="flex items-center gap-3 p-2 bg-black/5 rounded border border-black/10">
                <i class="bx bx-file text-2xl text-gray-500"></i>
                <span class="text-xs truncate flex-1">
                  <%= message.payload["filename"].presence || "Document" %>
                </span>
                <a href="<%= media_src %>" download class="text-white/70 hover:text-white text-xl">
                  <i class="bx bx-download text-lg"></i>
                </a>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Message text -->
    <% if message.template_message? && !message.payload["body_text"].present?%>
      <div class="text-[14px] leading-[19px] break-words whitespace-pre-line break-all pb-0.5">Template Message</div>
    <% else %>
      <% if message.payload["body_text"].present? %>
        <div class="text-[14px] leading-[19px] break-words whitespace-pre-line break-all pb-0.5"><%= message.payload["body_text"] %></div>
      <% end %>

      <% if message.payload["caption"] %>
        <div class="mt-1 text-[14px] leading-[19px] break-words break-all">
          <%= message.payload["caption"] %>
        </div>
      <% end %>
    <% end %>

    <!-- Sender and time-stamp -->
    <div class="flex justify-end items-center gap-1 text-[10px] opacity-80">
      <% if outgoing && message.user.present? %>
        <span class="text-white/70">
          <%= message.user.name %>
        </span>
        <span class="text-white/40">•</span>
      <% end %>
      <span>
        <%= message.created_at.strftime("%I:%M %p") %>
      </span>
      <% if outgoing %>
        <%= render partial: "messages/status_tick", locals: { message: message } %>
      <% end %>
    </div>
  </div>
</div>
<% end %>


