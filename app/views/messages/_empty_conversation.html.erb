<!-- app/views/messages/_empty_conversation.html.erb -->
<div class="min-h-[60vh] w-full flex items-center justify-center px-4">
  <div class="max-w-[560px] w-full">
    <div class="mx-auto w-full sm:w-fit px-4 py-3 rounded-xl bg-[rgb(var(--panel))]/85 border border-[rgb(var(--border))] shadow-sm">
      <div class="text-center text-[12px] leading-snug text-[rgb(var(--muted))]">
        <!-- First line with lock icon -->
        <div class="flex items-center justify-center gap-2 font-semibold text-[rgb(var(--text))]">
          <i class="bx bx-lock-alt text-[16px] text-[rgb(var(--muted))] flex-shrink-0"></i>
          <span>Messages are end-to-end encrypted</span>
        </div>
        <div class="mt-1">
          No one outside of this chat, not even Simple WA Connect, can read or listen to them.
        </div>
        <div class="mt-1 text-[rgb(var(--soft))]">
          Start messaging to begin the conversation.
        </div>
      </div>
    </div>
  </div>
</div>
